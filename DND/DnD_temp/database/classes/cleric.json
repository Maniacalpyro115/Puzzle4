  "features": [
    {
      "id": "spellcasting",
      "name": "Spellcasting",
      "level": 1,
      "category": "core",
      "summary": "Prepared Wisdom-based divine spellcasting with ritual casting and holy symbol focus."
    },
    {
      "id": "divine-domain",
      "name": "Divine Domain",
      "level": 1,
      "category": "subclass",
      "summary": "Choose a domain; it grants domain spells and subclass features at later levels.",
      "grantsSubclass": true
    },
    {
      "id": "channel-divinity",
      "name": "Channel Divinity",
      "level": 2,
      "category": "core",
      "summary": "Use divine energy for Turn Undead and domain-specific effects.",
      "usesByLevel": {
        "2": 1,
        "3": 1,
        "4": 1,
        "5": 1,
        "6": 2,
        "7": 2,
        "8": 2,
        "9": 2,
        "10": 2,
        "11": 2,
        "12": 2,
        "13": 2,
        "14": 2,
        "15": 2,
        "16": 2,
        "17": 2,
        "18": 3,
        "19": 3,
        "20": 3
      },
      "recharge": "short_or_long_rest"
    },
    {
      "id": "turn-undead",
      "name": "Turn Undead",
      "level": 2,
      "category": "channel-divinity",
      "summary": "Present holy symbol to force nearby undead to make a Wisdom save or be turned."
    },
    {
      "id": "harness-divine-power",
      "name": "Harness Divine Power",
      "level": 2,
      "category": "optional",
      "summary": "Spend Channel Divinity to recover a spell slot up to half proficiency bonus, rounded up.",
      "usesByLevel": {
        "2": 1,
        "3": 1,
        "4": 1,
        "5": 1,
        "6": 2,
        "7": 2,
        "8": 2,
        "9": 2,
        "10": 2,
        "11": 2,
        "12": 2,
        "13": 2,
        "14": 2,
        "15": 2,
        "16": 2,
        "17": 2,
        "18": 3,
        "19": 3,
        "20": 3
      },
      "recharge": "long_rest"
    },
    {
      "id": "ability-score-improvement",
      "name": "Ability Score Improvement",
      "levelGains": [4, 8, 12, 16, 19],
      "category": "core",
      "summary": "Increase ability scores or take equivalent character advancement where allowed."
    },
    {
      "id": "cantrip-versatility",
      "name": "Cantrip Versatility",
      "levelGains": [4, 8, 12, 16, 19],
      "category": "optional",
      "summary": "At ASI levels, replace one cleric cantrip with another from the cleric list."
    },
    {
      "id": "destroy-undead",
      "name": "Destroy Undead",
      "level": 5,
      "category": "core",
      "summary": "Turned undead below a CR threshold are destroyed instead.",
      "thresholdByLevel": {
        "5": "1/2",
        "8": "1",
        "11": "2",
        "14": "3",
        "17": "4"
      }
    },
    {
      "id": "blessed-strikes",
      "name": "Blessed Strikes",
      "level": 8,
      "category": "optional",
      "summary": "Once per turn, a cantrip or weapon attack can deal extra radiant damage.",
      "replacesOneOf": ["divine-strike", "potent-spellcasting"]
    },
    {
      "id": "divine-intervention",
      "name": "Divine Intervention",
      "level": 10,
      "category": "core",
      "summary": "Ask deity for aid; success chance is based on cleric level.",
      "automaticSuccessLevel": 20
    }
  ],
  "levelProgression": [
